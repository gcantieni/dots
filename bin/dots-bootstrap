#!/bin/sh
# Set up ~/.dots on a new host: clone, list files the checkout would overwrite and
# offer to move them to ~/.dots-backup/<timestamp>/, check out, run dots-init. Usage: dots-bootstrap [https|ssh] (default https).
# ssh creates ~/.ssh/id_ed25519 if missing and waits until GitHub accepts it.
# Prompts read /dev/tty, so it also works as sh -c "$(curl ...)".
set -e
mode=${1:-https}
dots() { git --git-dir="$HOME/.dots" --work-tree="$HOME" "$@"; }

case $mode in
https)
    url=https://github.com/gcantieni/dots.git
    ;;
ssh)
    url=git@github.com:gcantieni/dots.git
    key="$HOME/.ssh/id_ed25519"
    [ -f "$key" ] || ssh-keygen -t ed25519 -C "$(id -un)@$(uname -n)" -f "$key" </dev/tty
    eval "$(ssh-agent -s)" >/dev/null
    trap 'ssh-agent -k >/dev/null' EXIT
    ssh-add "$key" </dev/tty
    printf '\n%s\n\nAdd it at https://github.com/settings/ssh/new, then press Enter.\n' "$(cat "$key.pub")"
    until read -r _ </dev/tty || exit 1
        ssh -i "$key" -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new \
            -T git@github.com </dev/null 2>&1 | grep -q 'successfully authenticated'
    do
        echo "GitHub doesn't accept the key yet. Add it, then press Enter."
    done
    ;;
*)
    echo "usage: dots-bootstrap [https|ssh]" >&2
    exit 2
    ;;
esac

git clone --bare "$url" "$HOME/.dots"

conflicts=$(dots ls-tree -r --name-only HEAD | while IFS= read -r f; do
    if [ -e "$HOME/$f" ] || [ -L "$HOME/$f" ]; then
        printf '%s\n' "$f"
    fi
done)
if [ -n "$conflicts" ]; then
    backup="$HOME/.dots-backup/$(date +%Y%m%d-%H%M%S)"
    echo "The checkout would overwrite these files:"
    printf '%s\n' "$conflicts" | sed 's|^|  ~/|'
    printf 'Move them to ~/%s? [y/N] ' "${backup#"$HOME"/}"
    read -r ans </dev/tty || ans=
    case $ans in
    [yY]*) ;;
    *)
        rm -rf "$HOME/.dots"
        echo "Aborted. Removed ~/.dots; nothing else in ~ was changed."
        exit 1
        ;;
    esac
    printf '%s\n' "$conflicts" | while IFS= read -r f; do
        mkdir -p "$backup/$(dirname "$f")"
        mv "$HOME/$f" "$backup/$f"
    done
fi

dots checkout
"$HOME/bin/dots-init"
echo "Done. Open a new shell."
