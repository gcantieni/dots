#!/usr/bin/env bash
if [[ $# -eq 1 ]]; then
    selected=$1
else
  selected=$(find ~/proj -mindepth 1 -maxdepth 1 -type d | fzf)
    # [[ $selected ]] && selected="$HOME/$selected"
fi

if [[ -z $selected ]]; then
    exit 0
fi


selected_name=$(basename "$selected" | tr . _)
proj_dir=$selected

# Work in the project's dir, if gc-proj knows one.
if command -v gc-proj >/dev/null; then
   resolved=$(gc-proj dir "$proj_dir" 2>/dev/null)
   [[ -d $resolved ]] && selected=$resolved
fi

tmux_running=$(pgrep tmux)
if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
    tmux new-session -s $selected_name -c $selected -e PROJ="$proj_dir"
    exit 0
fi

if ! tmux has-session -t=$selected_name 2> /dev/null; then
    tmux new-session -ds $selected_name -c $selected -e PROJ="$proj_dir"
fi


# Try switching sessions, but if that doesn't work, attach.
if ! tmux switch-client -t $selected_name 2> /dev/null; then 
    tmux a -t $selected_name 
fi
