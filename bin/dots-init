#!/bin/sh
# Configure the ~/.dots repo on this host. Safe to re-run; dots-bootstrap calls it.
# Usage: dots-init [--git-identity]
# --git-identity also writes the personal git author identity to ~/.gitconfig.
# Off by default: ~/.gitconfig stays untracked so work hosts keep their own.
set -e
git_identity=
for arg; do
    case $arg in
    --git-identity) git_identity=1 ;;
    *)
        echo "usage: dots-init [--git-identity]" >&2
        exit 2
        ;;
    esac
done

dots() { git --git-dir="$HOME/.dots" --work-tree="$HOME" "$@"; }

dots config core.bare false
# Needed by anything that finds the repo through $GIT_DIR alone (nvim's :Dots).
dots config core.worktree "$HOME"
dots config remote.origin.fetch '+refs/heads/*:refs/remotes/origin/*'
dots fetch --quiet
dots branch --quiet -u origin/master master

dots config core.hooksPath "$HOME/.config/dots/hooks"
dots config status.showUntrackedFiles no
dots config pull.rebase true
dots config rebase.autostash true
dots config push.autoSetupRemote true

if [ -n "$git_identity" ]; then
    git config --global user.name 'Gus Cantieni'
    git config --global user.email gus.cantieni@gmail.com
    echo "git identity: $(git config --global user.name) <$(git config --global user.email)>"
fi

"$HOME/.config/agents/install"

echo "dots configured: hooks at $HOME/.config/dots/hooks"
