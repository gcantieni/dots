#!/usr/bin/env python3
"""Copy a blockquote or inline code span from a Claude Code pane, as markdown.

Claude Code draws blockquotes with a gutter glyph and hard-wraps them, and drops
the backticks around inline code, drawing it in its own color instead. This
recovers the markdown from those cues. Fenced blocks are better copied with
Claude's /copy, which picks a block from the raw response.
"""

import argparse
import os
import re
import shutil
import subprocess
import sys
import tempfile
import traceback
import unicodedata
from dataclasses import dataclass
from pathlib import Path

ESC_RE = re.compile(r"\x1b(?:\[([0-9;:]*)([A-Za-z])|\][^\x07\x1b]*(?:\x07|\x1b\\)|.)")
QUOTE_RE = re.compile(r"^\s*▎ ?")
LIST_RE = re.compile(r"^(?:[-*+]|\d+[.)]) ")

Cells = list[tuple[str, bool]]


def sgr_fg(params: str, fg: str | None) -> str | None:
    codes = params.split(";") if params else ["0"]
    i = 0
    while i < len(codes):
        c = codes[i]
        if c in ("", "0", "39"):
            fg = None
        elif c in ("38", "48", "58") and i + 1 < len(codes):
            n = 3 if codes[i + 1] == "5" else 5
            if c == "38":
                fg = ";".join(codes[i : i + n])
            i += n - 1
        elif c.isdigit() and (30 <= int(c) <= 37 or 90 <= int(c) <= 97):
            fg = c
        i += 1
    return fg


def parse_line(line: str, color: str) -> Cells:
    """Visible characters, each flagged True if drawn in the inline-code color."""
    cells: Cells = []
    fg: str | None = None
    pos = 0
    while pos < len(line):
        m = ESC_RE.match(line, pos) if line[pos] == "\x1b" else None
        if m:
            if m.group(2) == "m":
                fg = sgr_fg(m.group(1), fg)
            pos = m.end()
            continue
        ch = line[pos]
        if unicodedata.category(ch) == "Zs":
            ch = " "
        cells.append((ch, fg == color))
        pos += 1
    return cells


def text_of(cells: Cells) -> str:
    return "".join(ch for ch, _ in cells)


def lstrip_cells(cells: Cells) -> Cells:
    i = 0
    while i < len(cells) and cells[i][0] == " ":
        i += 1
    return cells[i:]


def join_wrapped(prev: Cells, nxt: Cells) -> Cells:
    """Join two lines Claude wrapped apart, keeping a code span whole."""
    tail = len(prev)
    while tail and prev[tail - 1][0] == " ":
        tail -= 1
    if not tail:
        return nxt
    if prev[tail - 1][1] and nxt and nxt[0][1]:
        return prev[: tail] + [c for c in prev[tail:] if c[1]] + nxt
    return prev[:tail] + [(" ", False)] + nxt


def to_markdown(cells: Cells) -> str:
    out: list[str] = []
    code = False
    for ch, is_code in cells:
        if is_code != code:
            out.append("`")
            code = is_code
        out.append(ch)
    if code:
        out.append("`")
    return "".join(out)


@dataclass
class Item:
    kind: str
    text: str


def quotes(lines: list[Cells]) -> list[Item]:
    items: list[Item] = []
    block: list[Cells] | None = None

    def close() -> None:
        nonlocal block
        if block is None:
            return
        paras: list[Cells] = []
        cur: Cells = []
        for row in block:
            row = lstrip_cells(row)
            if not row or not text_of(row).strip():
                if cur:
                    paras.append(cur)
                cur = []
            elif not cur:
                cur = row
            elif LIST_RE.match(text_of(row)):
                cur = cur + [("\n", False)] + row
            else:
                cur = join_wrapped(cur, row)
        if cur:
            paras.append(cur)
        text = "\n\n".join(to_markdown(p).rstrip() for p in paras)
        if text.strip():
            items.append(Item("quote", text))
        block = None

    for cells in lines:
        m = QUOTE_RE.match(text_of(cells))
        if m:
            if block is None:
                block = []
            block.append(cells[m.end() :])
        else:
            close()
    close()
    return items


def spans(lines: list[Cells]) -> list[Item]:
    items: list[Item] = []
    carry: Cells | None = None
    for cells in lines:
        runs: list[tuple[int, int]] = []
        i = 0
        while i < len(cells):
            if cells[i][1]:
                j = i
                while j < len(cells) and cells[j][1]:
                    j += 1
                runs.append((i, j))
                i = j
            else:
                i += 1
        text = text_of(cells)
        for k, (s, e) in enumerate(runs):
            run = cells[s:e]
            if k == 0 and carry is not None and not QUOTE_RE.sub("", text[:s]).strip():
                carry = join_wrapped(carry, run)
                continue
            if carry is not None:
                items.append(Item("code", text_of(carry).strip()))
            carry = run
        if carry is not None and (not runs or text[runs[-1][1] :].strip()):
            items.append(Item("code", text_of(carry).strip()))
            carry = None
    if carry is not None:
        items.append(Item("code", text_of(carry).strip()))
    return items


def copy(text: str) -> None:
    subprocess.run(["tmux", "load-buffer", "-w", "-"], input=text.encode(), check=True)
    if os.environ.get("DISPLAY") and shutil.which("xclip"):
        subprocess.run(["xclip", "-selection", "clipboard", "-in"], input=text.encode(), check=True)


def notify(msg: str) -> None:
    subprocess.run(["tmux", "display-message", "-d", "3000", msg])


def window_panes(pane: str) -> list[str]:
    """The pane first, then the other panes in its window."""
    out = subprocess.run(
        ["tmux", "list-panes", "-t", pane, "-F", "#{pane_id}"],
        capture_output=True, text=True, check=True,
    ).stdout.split()
    return [pane] + [p for p in out if p != pane]


def capture(pane: str, history: int, color: str) -> list[Cells]:
    text = subprocess.run(
        ["tmux", "capture-pane", "-p", "-e", "-J", "-t", pane, "-S", f"-{history}"],
        capture_output=True, text=True, check=True,
    ).stdout
    return [parse_line(line, color) for line in text.splitlines()]


def pick(items: list[Item]) -> Item | None:
    with tempfile.TemporaryDirectory() as tmp:
        rows = []
        by_label: dict[str, Item] = {}
        for i, item in enumerate(items):
            Path(tmp, str(i)).write_text(item.text + "\n")
            first = item.text.splitlines()[0]
            label = f"▎ {first}" if item.kind == "quote" else first
            by_label.setdefault(label, item)
            rows.append(f"{i}\t{label}")
        res = subprocess.run(
            [
                "fzf", "--no-sort", "--reverse", "--delimiter", "\t", "--with-nth", "2..",
                "--header", "copy quote or inline code (newest first)",
                "--preview", f"cat {tmp}/{{1}}", "--preview-window", "down,50%,wrap",
            ],
            input="\n".join(rows), stdout=subprocess.PIPE, text=True,
        )
    if res.returncode not in (0, 1, 130):
        notify(f"fzf failed with exit code {res.returncode}")
    if res.returncode != 0 or not res.stdout.strip():
        return None
    line = res.stdout.splitlines()[0]
    head, sep, label = line.partition("\t")
    if sep and head.isdigit():
        return items[int(head)]
    return by_label[line]


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("pane", nargs="?", help="tmux pane id (default: the active pane)")
    ap.add_argument("--history", type=int, default=300, help="scrollback lines to include")
    ap.add_argument("--color", default="38;5;153", help="SGR foreground of inline code")
    ap.add_argument("--only", action="store_true", help="skip the other panes in the window")
    ap.add_argument("--list", action="store_true", help="print items instead of picking")
    args = ap.parse_args()
    if not args.pane:
        args.pane = subprocess.run(
            ["tmux", "display-message", "-p", "#{pane_id}"],
            capture_output=True, text=True, check=True,
        ).stdout.strip()

    seen: set[str] = set()
    items: list[Item] = []
    for pane in [args.pane] if args.only else window_panes(args.pane):
        lines = capture(pane, args.history, args.color)
        found = [
            it for it in reversed(quotes(lines) + spans(lines))
            if len(it.text) >= 2 and any(c.isalnum() for c in it.text) and it.text not in seen
        ]
        found.sort(key=lambda it: it.kind != "quote")
        for it in found:
            if it.text not in seen:
                seen.add(it.text)
                items.append(it)

    if args.list:
        for item in items:
            print(f"--- {item.kind}\n{item.text}")
        return 0
    if not items:
        msg = "No Claude quote or inline code is visible in this window."
        if sys.stdin.isatty():
            input(f"{msg}\nPress Enter to close.")
        else:
            notify(msg)
        return 1

    chosen = pick(items)
    if chosen is None:
        return 0
    copy(chosen.text)
    notify(f"Copied: {chosen.text.splitlines()[0]}")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception:
        traceback.print_exc()
        if sys.stdin.isatty():
            input("Press Enter to close")
        sys.exit(1)
