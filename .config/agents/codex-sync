#!/usr/bin/env python3
"""Write $CODEX_HOME/AGENTS.md from ~/.config/agents/AGENTS.md with @ imports inlined.

Codex reads a single global AGENTS.md and doesn't follow Claude's @path imports.
"""
import os
import re
import sys
from pathlib import Path

SRC = Path.home() / ".config/agents/AGENTS.md"
MARK = "<!-- Generated by ~/.config/agents/codex-sync"
HEADER = f"{MARK} from {SRC}. Edit the sources, not this file. -->\n\n"
IMPORT = re.compile(r"^@(\S+)\s*$")
MAX_DEPTH = 5


def expand(path, depth, seen):
    out = []
    fenced = False
    for line in path.read_text().splitlines(keepends=True):
        if line.lstrip().startswith("```"):
            fenced = not fenced
        m = None if fenced else IMPORT.match(line)
        if not m:
            out.append(line)
            continue
        target = Path(os.path.expanduser(m.group(1)))
        if not target.is_absolute():
            target = path.parent / target
        target = target.resolve()
        if depth >= MAX_DEPTH or target in seen or not target.is_file():
            continue
        text = expand(target, depth + 1, seen | {target})
        if text and not text.endswith("\n"):
            text += "\n"
        out.append(text)
    return "".join(out)


def main():
    if not SRC.is_file():
        return 0
    home = Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex")
    dest = home / "AGENTS.md"
    text = HEADER + expand(SRC.resolve(), 0, {SRC.resolve()})
    if dest.exists():
        old = dest.read_text()
        if not old.startswith(MARK):
            print(f"codex-sync: skipping {dest}: not generated by codex-sync", file=sys.stderr)
            return 0
        if old == text:
            return 0
    home.mkdir(parents=True, exist_ok=True)
    tmp = dest.with_name(dest.name + ".tmp")
    tmp.write_text(text)
    os.replace(tmp, dest)
    return 0


if __name__ == "__main__":
    sys.exit(main())
