#!/bin/sh
# Link ~/.config/agents into the places agent tools read it from. Safe to re-run.
# Links only what is present. Machine-specific links go in install.local, which
# is sourced with link(), link_skill() and $src available.
set -e
src=$HOME/.config/agents
skill_dirs="$HOME/.claude/skills $HOME/.agents/skills"

link() {
    if [ -L "$2" ]; then
        rm "$2"
    elif [ -e "$2" ]; then
        echo "agents/install: skipping $2: exists and is not a link" >&2
        return 0
    fi
    mkdir -p "$(dirname "$2")"
    ln -s "$1" "$2"
}

link_skill() {
    for t in $skill_dirs; do
        link "$1" "$t/${1##*/}"
    done
}

for d in "$src"/skills/*/; do
    if [ -d "$d" ]; then
        link_skill "${d%/}"
    fi
done

# Merge the shared Claude settings (status line, hooks) into the host's own
# settings.json, which stays untracked; the fragment wins for the keys it sets.
settings=$HOME/.claude/settings.json
if [ -f "$src/claude-settings.json" ]; then
    if command -v jq >/dev/null 2>&1; then
        mkdir -p "$(dirname "$settings")"
        [ -f "$settings" ] || echo '{}' > "$settings"
        tmp=$(mktemp "$settings.XXXXXX")
        if jq -s '.[0] * .[1]' "$settings" "$src/claude-settings.json" > "$tmp"; then
            if cmp -s "$tmp" "$settings"; then
                rm "$tmp"
            else
                mv "$tmp" "$settings"
                echo "agents/install: updated $settings" >&2
            fi
        else
            rm "$tmp"
            echo "agents/install: couldn't merge $settings" >&2
        fi
    else
        echo "agents/install: skipping Claude settings: jq not found" >&2
    fi
fi

if [ -f "$src/install.local" ]; then
    . "$src/install.local"
fi

for t in $skill_dirs; do
    for l in "$t"/*; do
        if [ -L "$l" ] && [ ! -e "$l" ]; then
            case $(readlink "$l") in
                "$src"/*)
                    rm "$l"
                    echo "agents/install: removed stale link $l" >&2
                    ;;
            esac
        fi
    done
done

"$src/codex-sync"
