#!/bin/sh
# Link ~/.config/agents into the places agent tools read it from. Safe to re-run.
# Links only what is present. Machine-specific links go in install.local, which
# is sourced with link() and $src available.
set -e
src=$HOME/.config/agents

link() {
    if [ -L "$2" ]; then
        rm "$2"
    elif [ -e "$2" ]; then
        echo "agents/install: skipping $2: exists and is not a link" >&2
        return 0
    fi
    mkdir -p "$(dirname "$2")"
    ln -s "$1" "$2"
}

for f in AGENTS.md AGENTS.local.md; do
    if [ -e "$src/$f" ]; then
        link "$src/$f" "$HOME/$f"
    fi
done

for d in "$src"/skills/*/; do
    if [ -d "$d" ]; then
        d=${d%/}
        link "$d" "$HOME/.claude/skills/${d##*/}"
    fi
done

if [ -f "$src/install.local" ]; then
    . "$src/install.local"
fi

for l in "$HOME"/.claude/skills/*; do
    if [ -L "$l" ] && [ ! -e "$l" ]; then
        case $(readlink "$l") in
            "$src"/*)
                rm "$l"
                echo "agents/install: removed stale link $l" >&2
                ;;
        esac
    fi
done
